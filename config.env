# KernelSU Action -- build profile for Samsung A8 2018 (jackpotlte)
# Target: Nameless + KernelSU-Next (legacy) for GSI / PixelOS / Evolution X
# Android 12 - 14 (Treble GSI). Kernel remains 4.4.
#
# Recommended flash order after stock restore:
#   1. TWRP
#   2. FileVen / treble vendor (if needed for GSI)
#   3. Nameless kernel (AOSP + Permissive) OR this KSU build
#   4. PixelOS GSI system image
#   5. Optional: Permissiver zip if SELinux blocks boot
#
# Only the exact string "true" (or yes/on/1) counts as enabled.

CONFIG_ENV=config.env

# ============================================================ Kernel source ==

KERNEL_SOURCE=https://github.com/XIT07/android_kernel_samsung_universal7885
KERNEL_SOURCE_BRANCH=Nameless
KERNEL_CONFIG=exynos7885-jackpotlte_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Label used in artifacts and CONFIG_LOCALVERSION
KERNEL_NAME=Nameless-KSU-Next-A8-GSI

ADD_LOCALVERSION_TO_FILENAME=false

EXTRA_CMDS:LD=ld.lld KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
# Safe clang for 4.4 trees
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e

USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu-next
KSU_REF=legacy
KSU_HOOK_MODE=manual
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# =================================================================== SUSFS ==
# Keep off on 4.4 + GSI for stability
ENABLE_SUSFS=false
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===
ENABLE_PATH_UMOUNT=false
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=false
DISABLE_CC_WERROR=false

# KernelSU + GSI-friendly options
# SELinux: keep BOOTPARAM so androidboot.selinux=permissive works from cmdline
# (Nameless AROMA / Permissiver also set permissive for GSI)
EXTRA_DEFCONFIG=CONFIG_KSU=y CONFIG_KSU_MANUAL_HOOK=y CONFIG_OVERLAY_FS=y CONFIG_SECURITY_SELINUX_BOOTPARAM=y CONFIG_SECURITY_SELINUX_SETENFORCE_OVERRIDE=y

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
